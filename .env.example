# Copy to .env and adjust. No secrets required for core system.
# DATA_MODE=full  -> use entire real Food.com dataset in data/raw/
# DATA_MODE=sample -> use a REAL SUBSET of Food.com data (deterministic head/sample) for dev/debug.
DATA_MODE=sample
SAMPLE_N_RECIPES=10000
SAMPLE_N_INTERACTIONS=100000
RANDOM_STATE=42
# Hybrid weights (must sum ~1; validated at runtime)
W_BASELINE=0.5
W_TEMPORAL=0.25
W_ASPECT=0.25
# Temporal params
TEMPORAL_MODE=exp_decay
TEMPORAL_LAMBDA=0.02
HIST_WEIGHT=0.3
RECENT_WEIGHT=0.7
# Optional LLM enhancement (off by default; core works without it)
LLM_PROVIDER=none
# TasteFlow app auth (backend). Set a long random value in production.
TASTEFLOW_SECRET=change-me-to-a-long-random-string-in-production
# Auth backstop rate limit (requests/min/IP on login+register; proxy enforces real limits)
RATE_LIMIT_AUTH_PER_MIN=60
# CORS allow-list (comma-separated). Empty = same-origin only (default).
CORS_ORIGINS=
# Product ranking weights (cook + search fusion; research weights above are separate)
COOK_W_COVERAGE=0.5
COOK_W_PREF=0.3
COOK_W_QUALITY=0.2
SEARCH_W_KEYWORD=0.4
SEARCH_W_SEMANTIC=0.3
SEARCH_W_PREF=0.3
# TasteFlow app database path (default: ./tasteflow.db). Tests use an isolated temp file.
TASTEFLOW_DB=./tasteflow.db
